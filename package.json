{
  "name": "banking-platform",
  "version": "1.0.0",
  "description": "Modern banking platform with customer dashboard and transaction management",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "banking",
    "fintech",
    "dashboard",
    "transactions"
  ],
  "author": "doughertylevi5150-dev",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.0",
    "mongoose": "^7.5.0",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.1",
    "jest": "^29.7.0",
    "eslint": "^8.49.0",
    "prettier": "^3.0.3"
  }
}
