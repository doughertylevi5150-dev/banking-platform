{
  "name": "banking-platform",
  "version": "1.0.0",
  "description": "Banking operations console with owner-only authentication (Express, JWT, bcrypt)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "banking",
    "fintech",
    "dashboard",
    "transactions"
  ],
  "author": "doughertylevi5150-dev",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20"
  },
  "type": "module"
}
